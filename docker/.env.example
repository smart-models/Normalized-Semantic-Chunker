# =============================================================================
# Normalized Semantic Chunker - Docker Environment Variables
# =============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# =============================================================================

# --- Authentication ---
# Bearer token for API access. Leave empty to disable authentication.
# When set, all POST endpoints require: Authorization: Bearer <token>
# The GET / health check is always accessible.
API_TOKEN=

# --- File Limits ---
# Maximum size (in bytes) of an uploaded file. Default: 10485760 (10 MB).
MAX_FILE_SIZE=

# Maximum size (in characters) of a single chunk's text field in JSON input.
# Chunks exceeding this limit are rejected with HTTP 400. Default: 100000 (100k chars).
MAX_CHUNK_TEXT_SIZE=

# --- Processing ---
# Default embedding model loaded at startup.
EMBEDDER_MODEL=

# Maximum number of parallel worker processes for percentile search. Default: auto (CPU count - 1, max 4).
MAX_WORKERS=

# Timeout in seconds for each worker process (ProcessPoolExecutor). Default: 300 (5 minutes).
WORKER_TIMEOUT=

# Model cache timeout in seconds. Unused models are evicted after this period. Default: 3600 (1 hour).
CACHE_TIMEOUT=
